  "narrative": {
    "northStar": "The Picture-Book Cutaway Town",
    "overview": "Each section is a building in one town, drawn as a gouache-flat dollhouse cross-section, and the reader walks down a single street from morning to night. The product story is told as a picture: your sentence goes from your mouth through the house's machinery to the screen, and the cloud van outside gets nothing. Copy sits beside the picture in large hand-lettered type, the same way a children's book puts a sentence next to the drawing.\n\nEvery drawn object has a thin warm-brown outline and a slight hand wobble. Every object that needs explaining gets a small printed label with a hairline pointer. Density is generous: the drawings fill the width and keep growing on wide screens, and the copy column stays narrow.",
    "keyCharacteristics": [
      "Hand-authored inline SVG on flat fills; no colour gradients, no generated rasters.",
      "One warm-brown outline (2.5px) holds every shape, in drawings and in UI chrome alike.",
      "The sky changes colour section by section from day blue to dusk to night.",
      "Each section ends on the same strip of grass, road and grass, which ties the town together.",
      "Dollhouse fronts swing open as each building scrolls in."
    ],
    "rules": [
      {
        "name": "The Sky Clock Rule",
        "body": "Each section sets its own `--sky`, in this order down the page: #A9D5EE, #B4DBEF, #C3E3F1, #D2E9EC, #F6D2A8, #F1BD97, #E8A98F, #C9A2BF, #A799CB, #4F5C99, #3B4782, #2F3A6B, then the footer at #232B52. A new section takes the next sky in that sequence; it never jumps back to day.",
        "section": "colors"
      },
      {
        "name": "The One Outline Rule",
        "body": "Strokes and borders use outline (#6B4A2E) and nothing else: 2.5px on objects and UI edges, 1.4px for hairlines and pointers. Black is reserved for the robot (#141414) and dark screens.",
        "section": "colors"
      },
      {
        "name": "The Painted Sign Rule",
        "body": "Uppercase and wide tracking belong only to signs painted on buildings and vehicles inside the SVG. HTML copy is always sentence case.",
        "section": "typography"
      },
      {
        "name": "The Lit-Object Rule",
        "body": "A shadow means \"this is a physical thing lying on the scene\". Flat page chrome gets no shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** draw every new section as a building on the road band, with the next sky from the Sky Clock sequence.",
      "**Do** hold every shape with the 2.5px outline (#6B4A2E) and put drawn parts inside the `#hand` filter.",
      "**Do** explain scene objects with Patrick Hand labels and 1.4px hairline pointers ending in a dot.",
      "**Do** use school-bus yellow for the one action in a view, and keep its label \"Apply for beta\".",
      "**Do** give every scene a full `aria-label` or `title` describing the picture, and keep live parts out of the filter.",
      "**Do** honour reduced motion by stopping loops and leaving facades open."
    ],
    "donts": [
      "**Don't** use colour gradients, glass effects, photographs or generated rasters in scenes; app screenshots appear only inside drawn screens.",
      "**Don't** use black strokes or hard drop shadows; the keycap's side wall is the only flat offset.",
      "**Don't** put uppercase tracked labels above HTML headlines; uppercase lives only on painted signs.",
      "**Don't** shrink scenes on phones; pan them at their minimum width instead.",
      "**Don't** let the form post from localhost, 127.0.0.1 or file previews."
    ]
  }
