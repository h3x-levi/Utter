      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action: Apply for beta.",
      "html": "<a class=\"ds-go\" href=\"#\">Apply for beta</a>",
      "css": ".ds-go{display:inline-flex;align-items:center;font:700 22px/1 Grandstander,sans-serif;color:#3A2616;background:#F3C13A;border:2.5px solid #6B4A2E;border-radius:16px;padding:.72em 1.15em;text-decoration:none;box-shadow:0 5px 12px -4px rgba(58,38,22,.45);transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s cubic-bezier(.2,.8,.2,1)}.ds-go:hover{transform:translateY(-2px);box-shadow:0 9px 18px -6px rgba(58,38,22,.5)}.ds-go:active{transform:translateY(1px) scale(.98)}.ds-go:focus-visible{outline:3px solid #C8402F;outline-offset:3px}"
    },
