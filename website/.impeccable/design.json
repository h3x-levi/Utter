      "css": ".ds-field{display:grid;gap:6px;font:22px \"Patrick Hand\",cursive}.ds-field span{font:700 .82em/1.2 Grandstander,sans-serif;color:#3A2616}.ds-field b{color:#C8402F}.ds-field input{font:inherit;color:#3A2616;background:#FFFDF6;border:2.5px solid #6B4A2E;border-radius:12px;padding:.5em .7em}.ds-field input::placeholder{color:#7A6350}.ds-field input:focus{outline:3px solid #F3C13A;outline-offset:1px}"
