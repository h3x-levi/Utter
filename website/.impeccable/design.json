      "css": ".ds-ghost{display:inline-flex;align-items:center;gap:10px;color:#3A2616;text-decoration:none;font:22px \"Patrick Hand\",cursive}.ds-ghost:hover span{text-decoration:underline;text-decoration-color:#C8402F;text-underline-offset:5px;text-decoration-thickness:2px}.ds-ghost:focus-visible{outline:3px solid #C8402F;outline-offset:3px}"
