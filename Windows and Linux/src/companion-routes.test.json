      {"signal":"talking","detail":{},"now":30000,"expect":"r-tap"},
      {"signal":"quiet","detail":{},"now":30999,"expect":null},
      {"signal":"quiet","detail":{},"now":31000,"expect":"r-tap"},
      {"signal":"near","detail":{},"now":0,"expect":"r-curious"},
      {"signal":"near","detail":{},"now":89999,"expect":null},
      {"signal":"near","detail":{},"now":90000,"expect":"r-curious"}
    ] },
    { "name": "a cooling route falls through to the next match", "steps": [
