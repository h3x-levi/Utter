    { "name": "atLeast is inclusive and a missing key fails", "steps": [
      {"signal":"done","detail":{"words":150,"total":500},"now":0,"expect":"r-long-one"},
      {"signal":"done","detail":{"words":149,"total":500},"now":0,"random":0,"expect":"r-done-a"},
      {"signal":"fling","detail":{"speed":2400},"now":0,"expect":"r-dizzy"},
      {"signal":"fling","detail":{},"now":0,"expect":null},
      {"signal":"poke","detail":{"count":5},"now":0,"expect":"r-streak"}
    ] },
    { "name": "a pool never repeats its previous pick", "steps": [
      {"signal":"poke","detail":{"count":1},"now":0,"random":0,"expect":"r-poke-a"},
      {"signal":"poke","detail":{"count":2},"now":100,"random":0,"expect":"r-poke-b"},
      {"signal":"poke","detail":{"count":3},"now":200,"random":0.99,"expect":"r-poke-a"},
      {"signal":"poke","detail":{"count":5},"now":300,"random":0,"expect":"r-streak"},
      {"signal":"poke","detail":{"count":1},"now":2000,"random":0,"expect":"r-poke-b"},
      {"signal":"done","detail":{"words":10,"total":10},"now":0,"random":0.99,"expect":"r-done-c"},
      {"signal":"done","detail":{"words":10,"total":20},"now":0,"random":0.99,"expect":"r-done-b"},
      {"signal":"done","detail":{"words":10,"total":30},"now":0,"random":0.99,"expect":"r-done-c"}
    ] },
    { "name": "a one-moment pool may repeat", "steps": [
