{
  "about": "route: fresh memory {at:{}, last:{}} per case, kept across its steps; call route({routes}, signal, detail, memory, now, () => random). A missing random means 0. clock: parse date as local time; call clock({times}, date). hear: fresh Behaviour, cue listening, then hear(level, t0 + ms) for each [ms, level]; expect lists the talking/quiet cues in order.",
  "times": {
    "morning": {"name":"Morning","from":5,"to":11,"speed":1.15,"lid":0,"blink":0.9},
    "day": {"name":"Day","from":11,"to":17,"speed":1,"lid":0,"blink":1},
    "evening": {"name":"Evening","from":17,"to":22,"speed":0.9,"lid":4,"blink":1.15},
    "night": {"name":"Late night","from":22,"to":5,"speed":0.8,"lid":9,"blink":1.4}
  },
  "routes": [
    {"signal":"listening","is":{"destination":["note","memory"]},"moment":"r-jot-down"},
    {"signal":"listening","is":{"mode":"handsFree"},"moment":"r-settle-in"},
    {"signal":"listening","moment":"r-lean-in"},
    {"signal":"done","is":{"goal":"dictation"},"moment":"r-goal"},
    {"signal":"done","every":1000,"moment":"r-milestone"},
    {"signal":"done","atLeast":{"words":150},"moment":"r-long-one"},
    {"signal":"done","moments":["r-done-a","r-done-b","r-done-c"]},
    {"signal":"notice","is":{"remembered":true,"timed":true},"moment":"r-tie-string"},
    {"signal":"notice","is":{"remembered":true},"moment":"r-tuck-away"},
    {"signal":"reminder","is":{"kind":"pomodoro","focus":false},"moment":"r-focus-on"},
    {"signal":"reminder","is":{"kind":"pomodoro","focus":true},"moment":"r-break"},
    {"signal":"talking","moment":"r-tap","cooldown":30000},
    {"signal":"quiet","moment":"r-tap","cooldown":30000},
    {"signal":"poke","atLeast":{"count":5},"moment":"r-streak"},
    {"signal":"poke","moments":["r-poke-a","r-poke-b"]},
    {"signal":"fling","atLeast":{"speed":2400},"moment":"r-dizzy","cooldown":60000},
    {"signal":"fling","atLeast":{"speed":1200},"moment":"r-wobble","cooldown":60000},
    {"signal":"near","moment":"r-curious","cooldown":90000},
    {"signal":"ambient","is":{"month":10,"day":31},"moment":"r-pumpkin","cooldown":10800000},
    {"signal":"ambient","is":{"weekday":[0,6]},"moments":["r-weekend"],"cooldown":10800000},
    {"signal":"ambient","is":{"time":["evening","night"]},"moments":["r-dusk-a","r-dusk-b"],"cooldown":600000},
    {"signal":"shown","moment":"r-hello"}
  ],
  "route": [
    { "name": "first match wins; destination before mode", "steps": [
      {"signal":"listening","detail":{"mode":"handsFree","destination":"note"},"now":0,"expect":"r-jot-down"},
      {"signal":"listening","detail":{"mode":"handsFree","destination":"app"},"now":0,"expect":"r-settle-in"},
      {"signal":"listening","detail":{"mode":"recording","destination":"app"},"now":0,"expect":"r-lean-in"},
      {"signal":"listening","detail":{"destination":"memory"},"now":0,"expect":"r-jot-down"},
      {"signal":"listening","detail":{},"now":0,"expect":"r-lean-in"},
      {"signal":"done","detail":{"goal":"dictation","words":40,"total":1020},"now":0,"expect":"r-goal"}
    ] },
    { "name": "is is strict and a missing key fails", "steps": [
      {"signal":"listening","detail":{"destination":"Note"},"now":0,"expect":"r-lean-in"},
      {"signal":"reminder","detail":{"kind":"pomodoro"},"now":0,"expect":null},
      {"signal":"reminder","detail":{"kind":"pomodoro","focus":"false"},"now":0,"expect":null},
      {"signal":"reminder","detail":{"kind":"pomodoro","focus":0},"now":0,"expect":null},
      {"signal":"reminder","detail":{"kind":"pomodoro","focus":false},"now":0,"expect":"r-focus-on"},
      {"signal":"reminder","detail":{"kind":"pomodoro","focus":true},"now":0,"expect":"r-break"},
      {"signal":"reminder","detail":{"kind":"stretch","focus":false},"now":0,"expect":null},
      {"signal":"notice","detail":{"remembered":true,"timed":false},"now":0,"expect":"r-tuck-away"},
      {"signal":"notice","detail":{"remembered":true,"timed":true},"now":0,"expect":"r-tie-string"},
      {"signal":"notice","detail":{"remembered":"true"},"now":0,"expect":null},
      {"signal":"notice","detail":{},"now":0,"expect":null}
    ] },
    { "name": "list is matches one of its values, strictly", "steps": [
      {"signal":"ambient","detail":{"weekday":"6"},"now":0,"expect":null},
      {"signal":"ambient","detail":{"weekday":1},"now":0,"expect":null},
      {"signal":"ambient","detail":{"weekday":0},"now":0,"expect":"r-weekend"}
    ] },
    { "name": "every fires when the total crosses a multiple", "steps": [
